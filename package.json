{
  "name": "femtech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": "^11"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config vitest.config.mts",
    "test:watch": "cross-env NODE_OPTIONS=--no-deprecation vitest --config vitest.config.mts",
    "ci:quality": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run format:check && pnpm run build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@open-waters-digital/analytics": "1.2.0",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-s3": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.4.5",
    "payload": "3.90.1",
    "posthog-js": "1.447.3",
    "posthog-node": "5.63.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.24.0",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "28.1.0",
    "prettier": "^3.4.2",
    "railway": "3.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  }
}
