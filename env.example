# Copy to .env and fill in. The real file is never committed.
#
# Named env.example rather than .env.example, matching the sibling Open Waters
# repos (agent file-write rules block the dotted path).
#
# Everything is read server side except NEXT_PUBLIC_*, which is inlined into
# the client bundle at build time and so is also a Docker build argument.
# Every variable here is also listed in .railway/railway.ts: a variable missing
# there is DELETED from the Railway service on `railway config apply`.

# ---------------------------------------------------------------------------
# Required everywhere
# ---------------------------------------------------------------------------

# Postgres. `pnpm run db:up` starts the local one this matches, on 5435 (see
# compose.yaml for why not 5432).
DATABASE_URL=postgres://femtech:femtech@localhost:5435/femtech

# Signs Payload's sessions and the sign-up form's dwell token. Generate with
# `openssl rand -hex 32`. Changing it logs everyone out.
PAYLOAD_SECRET=replace-me-with-32-random-bytes

# The site's own origin, no trailing slash. Canonical URLs, the sitemap, share
# previews and the admin link in the sign-up email are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# production | preview | development. Only production is indexed by search
# engines, and only production treats missing mail settings as an error.
SITE_ENV=development

# ---------------------------------------------------------------------------
# Sign-up notification email, through Resend. Unset locally: sign-ups are still
# saved, and the member is marked "Not emailed (development)".
# ---------------------------------------------------------------------------

# RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. FemTech Healthcare Network <hello@femtechhealth.com>
# SIGNUP_FROM_EMAIL=
# Who is told about each sign-up. Several addresses may be separated by commas.
# SIGNUP_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Event RSVP. The confirmation is sent through Resend with SIGNUP_FROM_EMAIL,
# to the registrant only. Cloudflare Turnstile stands in front of the form,
# because that email goes to whatever address is typed. Unset locally:
# Cloudflare's always-pass test keys are used. Unset anywhere else (preview
# included): RSVP is refused and an error is logged.
# ---------------------------------------------------------------------------

# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Object storage. Unset locally: uploads go to ./media and ./videos instead.
# Set as a group or not at all; a half-configured bucket throws at boot.
# ---------------------------------------------------------------------------

# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Seeding an empty database. Read only by `pnpm run seed`, never by a deploy.
# ---------------------------------------------------------------------------

# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
