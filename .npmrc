legacy-peer-deps=true

# @open-waters-digital packages are private, on GitHub Packages. The token is
# never here: pnpm 11.5.3+ will not expand variables in a committed .npmrc. It
# comes from ~/.npmrc locally, from actions/setup-node with the run's
# GITHUB_TOKEN in CI, and from scripts/docker-install.sh in the Docker build.
@open-waters-digital:registry=https://npm.pkg.github.com
